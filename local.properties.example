# Copy this file to local.properties (which is gitignored) and fill in real values.
# local.properties is never committed — this example file just documents what's needed.

sdk.dir=/path/to/your/Android/sdk

# Supabase project for Kalaza Leads — a standalone project, not shared with
# Kalaza Care (see docs/PROGRESS.md §6 for why). The anon key is safe to ship
# client-side once Row-Level Security is enabled on every table. Never put the
# service-role key here or anywhere in the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
